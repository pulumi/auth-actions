{
  "name": "pulumi-github-auth-action",
  "version": "2.1.1",
  "main": "dist/index.js",
  "repository": "git@github.com:pulumi/auth-actions",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf coverage build tmp dist",
    "prebuild": "npm run clean",
    "build": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "jest --coverage src/**/*",
    "test:watch": "jest --watch",
    "postinstall": "husky install .github/husky",
    "check-types": "tsc --noemit",
    "lint": "eslint . && npm run check-types",
    "lint:fix": "eslint . --fix && npm run check-types"
  },
  "lint-staged": {
    "src/**/*.{yaml,yml}": "prettier --write",
    "src/**/*.{js,ts}": "eslint --cache --fix",
    "src/**/*.ts": "tsc --noemit",
    "*.md": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/axios": "^0.14.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-playback": "^4.1.0",
    "lint-staged": "^17.6.0",
    "nock": "^15.0.2",
    "prettier": "3.9.10",
    "rimraf": "~6.1.3",
    "rollup": "^4.64.10",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@pulumi/actions-helpers": "^0.2.0"
  }
}
